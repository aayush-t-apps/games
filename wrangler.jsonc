// Cloudflare Worker config. Production is the top level; staging (if enabled) is env.staging.
// Files in ./site are served for free; Worker code runs only for run_worker_first paths.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Previews are made only when a PR asks (its label "preview"): the pipeline turns them on for it.
  // Deploys keep them off, and closing the PR turns them off again.
  // No staging: PR previews are versions of this Worker, so an app that keeps data gets none.
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/.well-known/shipify.json", "/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Durable Objects (AGENTS.md, "Storage"): classes only add. Each class in src/worker/objects/
  // is in `exports`; a deploy stops on a deleted or renamed class.
  // No PR previews: Cloudflare makes none for a Worker with Durable Objects.
  // Room: one per room code, a relay with seats and the last snapshot. Hub: one, the catalogue,
  // live rooms and matches.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "HUB", "class_name": "Hub" }]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
    "Hub": { "type": "durable-object", "storage": "sqlite" }
  },
  // ACCESS_TEAM (<team>.cloudflareaccess.com) and ACCESS_AUD (the Access app's audience tag) come
  // from the owner's Access setup (docs/adr/0001-members-sign-in-with-access.md). Neither is a
  // secret: Access sends the AUD tag to every browser it signs in. Empty: online play is off.
  // On localhost (make dev, the tests) the caller is always the developer. ADMIN_EMAIL is a
  // runtime secret (shipify.json).
  "vars": {
    "APP_ID": "games",
    "APP_ENV": "production",
    "GIT_SHA": "dev",
    "ACCESS_TEAM": "rough-morning-dee7.cloudflareaccess.com",
    "ACCESS_AUD": "444e544988d68a02d60d218c4d753cfa7e179bfa6fef0905eaf1b7e79151785f" // gitleaks:allow: a public Access audience tag, not a key
  }
}
